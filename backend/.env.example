PORT=3000
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
FRONTEND_URL=https://campusblink.me
ALLOWED_ORIGINS=https://campusblink.me,http://localhost:5173
JWT_SECRET=
ADMIN_EMAILS=admin@campusblink.me

# Firebase Admin SDK (Push Notifications via FCM)
# Option A (recommended for cloud/server deployments): Paste the full JSON string from the service account key file
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Option B (local dev): Set the path to the downloaded JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option C (default): Place the file at backend/firebase-service-account.json (no env var needed)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Clerk Webhook Signing Secret
# Get from: Clerk Dashboard → Webhooks → select endpoint → Signing Secret
# Used to verify the HMAC signature on incoming webhook events (prevents spoofing)
CLERK_WEBHOOK_SIGNING_SECRET=
